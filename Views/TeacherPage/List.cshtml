@model List<HTTP_5125_Cumulative2.Models.Teacher>

@{
    ViewData["Title"] = "Teacher List";
}

<h2>@ViewData["Title"]</h2>

<!-- Search Form -->
<form method="get" asp-action="List">
    <div class="form-group">
        <label for="SearchKey">Search Teachers:</label>
        <input type="text" id="SearchKey" name="SearchKey" class="form-control" placeholder="Search by name or employee number" value="@Context.Request.Query["SearchKey"]" />
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<!-- Teacher List -->
<table class="table mt-4">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Employee Number</th>
            <th>Hire Date</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Model)
        {
            <tr>
                <td>@teacher.TeacherFName</td>
                <td>@teacher.TeacherLName</td>
                <td>@teacher.EmployeeNumber</td>
                <td>@teacher.HireDate.ToString("yyyy-MM-dd")</td>
                <td>@teacher.Salary.ToString("C")</td>
                <td>
                    <a href="@Url.Action("Show", new { id = teacher.TeacherId })" class="btn btn-info">View</a>
                    <a href="@Url.Action("DeleteConfirm", new { id = teacher.TeacherId })" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.Count == 0)
{
    <p>No teachers found.</p>
}
